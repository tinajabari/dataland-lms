# برای اتصال به SQL Server: این فایل را کپی کنید به اسم  .env  (کنار manage.py)
# و مقدارها را مطابق سرور خودتان تغییر دهید. فایل .env وارد گیت نمی‌شود.

# نام دیتابیس (همان که در SSMS می‌بینید)
MSSQL_NAME=Semtec_LMS

# نام سرور — همان «Server name» که در پنجره‌ی اتصال SSMS می‌نویسید. نمونه‌ها:
#   localhost               (نمونه‌ی پیش‌فرض)
#   localhost\SQLEXPRESS    (نمونه‌ی Express)
#   DESKTOP-R08V8B6\SQLEXPRESS
MSSQL_HOST=localhost

# اگر با «Windows Authentication» وصل می‌شوید این دو خط را خالی بگذارید.
# اگر با یوزر sa یا یوزر SQL وصل می‌شوید، پر کنید:
MSSQL_USER=
MSSQL_PASSWORD=

# (اختیاری) اگر Driver 18 نصب نیست:  ODBC Driver 17 for SQL Server
# MSSQL_DRIVER=ODBC Driver 17 for SQL Server
